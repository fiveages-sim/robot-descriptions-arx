<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arx_lift2s_base">
	<xacro:arg name="robot_name" default="arx_lift2s_base"/>
	<!-- Injected true by robot_common_launch for OCS2 planning URDF; viz / ros2_control keep false -->
	<xacro:arg name="eef_fixed_joints" default="false"/>

	<xacro:macro name="chassis" params="enable_wheel_joints:='false' collider:='simple'">

		<link name="base_link">
			<inertial>
				<origin xyz="-0.010039 0.0013761 0.04956"/>
				<mass value="21.045"/>
				<inertia ixx="1.70029164" ixy="-0.00073232" ixz="-0.03255532" iyy="1.70804910" iyz="-0.00688370"
								 izz="0.97173287"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find arx_lift2s_description)/meshes/chassis/base_link.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find arx_lift2s_description)/meshes/chassis/base_link.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<!-- Main chassis deck (not used in OCS2 arm self-collision pairs) -->
				<collision name="simple_base_platform">
					<origin xyz="-0.09 0 0.0" rpy="0 0 0"/>
					<geometry>
						<box size="0.52 0.36 0.22"/>
					</geometry>
				</collision>
				<!-- Left / right side skirts -->
				<collision name="simple_base_left">
					<origin xyz="0.0 0.24 -0.066" rpy="0 0 0"/>
					<geometry>
						<box size="0.44 0.18 0.13"/>
					</geometry>
				</collision>
				<collision name="simple_base_right">
					<origin xyz="0.0 -0.24 -0.066" rpy="0 0 0"/>
					<geometry>
						<box size="0.43 0.18 0.13"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Dedicated mast link so OCS2 pairs hit the lift column, not deck/skirts/rear panel -->
		<link name="lift_mast_link">
			<xacro:if value="${collider == 'simple'}">
				<collision name="simple_lift_mast">
					<origin xyz="0 0 0" rpy="0 0 0"/>
					<geometry>
						<box size="0.13 0.13 0.60"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'convex'}">
				<!-- approximate mast volume when convex meshes are used on base/lift -->
				<collision name="simple_lift_mast">
					<origin xyz="0 0 0" rpy="0 0 0"/>
					<geometry>
						<box size="0.13 0.13 0.60"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>
		<joint name="lift_mast_joint" type="fixed">
			<origin xyz="0.01 0 0.50" rpy="0 0 0"/>
			<parent link="base_link"/>
			<child link="lift_mast_link"/>
		</joint>

		<link name="lift_link">
			<inertial>
				<origin xyz="-0.053315 -0.00061422 -0.0086454"/>
				<mass value="14.181"/>
				<inertia ixx="0.32744849" ixy="-0.00306617" ixz="0.05920163" iyy="0.36541112" iyz="0.00117932"
								 izz="0.49616592"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find arx_lift2s_description)/meshes/chassis/lift.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find arx_lift2s_description)/meshes/chassis/lift.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<!-- Carriage plate only (avoid rear upright registering as back screen) -->
				<collision name="simple_lift_carriage">
					<origin xyz="-0.015 0 -0.01" rpy="0 0 0"/>
					<geometry>
						<box size="0.24 0.16 0.12"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Same pattern as m6_ccs joint4 + eef_fixed_joints:
		     planning URDF → 0.30 m (hybrid MIT pack ±12.5 rad / 41.54);
		     viz / ros2_control → 0.48 m (HI height_span_m / soft_p setHeight). -->
		<xacro:property name="lift_joint_upper"
										value="${0.30 if '$(arg eef_fixed_joints)' == 'true' else 0.48}"/>

		<joint name="lift_joint" type="prismatic">
			<origin xyz="0.040103 0.0007607 0.221608"/>
			<parent link="base_link"/>
			<child link="lift_link"/>
			<axis xyz="0 0 1"/>
			<limit lower="0" upper="${lift_joint_upper}" effort="400" velocity="0.15"/>
		</joint>

		<xacro:property name="wheel_joint_type" value="fixed"/>
		<xacro:if value="${enable_wheel_joints}">
			<xacro:property name="wheel_joint_type" value="continuous"/>
		</xacro:if>

		<xacro:if value="${enable_wheel_joints}">
			<link name="wheel_1"/>
			<link name="wheel_2"/>
			<link name="wheel_3"/>
		</xacro:if>
		<xacro:unless value="${enable_wheel_joints}">
			<xacro:include filename="$(find component_models)/xacro/omnia_150.xacro"/>
			<xacro:wheel wheel_name="wheel_1" enable_passive_wheels="false"/>
			<xacro:wheel wheel_name="wheel_2" enable_passive_wheels="false"/>
			<xacro:wheel wheel_name="wheel_3" enable_passive_wheels="false"/>
		</xacro:unless>

		<!-- 轮组：URDF 名 wheel_1/2/3 为建模名；官方文档编号为
		     1=车尾(-x)、2=右前(+x,-y)、3=左前(+x,+y)。里程计雅可比按官方编号排 getWheelVel。 -->
		<joint name="wheel1_joint" type="${wheel_joint_type}">
			<origin xyz="0.15361 0.29246 -0.093" rpy="0.0 0.0 1.0472"/>
			<parent link="base_link"/>
			<child link="wheel_1"/>
			<xacro:if value="${enable_wheel_joints}">
				<axis xyz="1 0 0"/>
			</xacro:if>
		</joint>

		<joint name="wheel2_joint" type="${wheel_joint_type}">
			<origin xyz="0.15361 -0.29245 -0.093" rpy="0.0 0.0 -1.0472"/>
			<parent link="base_link"/>
			<child link="wheel_2"/>
			<xacro:if value="${enable_wheel_joints}">
				<axis xyz="1 0 0"/>
			</xacro:if>
		</joint>

		<joint name="wheel3_joint" type="${wheel_joint_type}">
			<origin xyz="-0.35293 0 -0.093" rpy="0.0 0.0 3.1415"/>
			<parent link="base_link"/>
			<child link="wheel_3"/>
			<xacro:if value="${enable_wheel_joints}">
				<axis xyz="1 0 0"/>
			</xacro:if>
		</joint>

	</xacro:macro>
</robot>
