<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="ac_one">

		<link name="body_link">
			<inertial>
				<origin xyz="0.0040185 3.8157E-05 -0.024465"/>
				<mass value="5.6137" />
				<inertia
						ixx="0.21931087"
						ixy="0.00000492"
						ixz="-0.00198722"
						iyy="0.02598322"
						iyz="-0.00000228"
						izz="0.20840406" />
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find arx_lift2s_description)/meshes/ac_one/base.glb"/>
				</geometry>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file://$(find arx_lift2s_description)/meshes/ac_one/base.glb"/>
				</geometry>
			</collision>
		</link>

		<link name="head_camera">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/d405/d405.obj"/>
				</geometry>
			</visual>
		</link>

		<joint name="head_camera_joint" type="fixed">
			<origin xyz="0.090415 0.002 0.2285" rpy="0 1.0472 0"/>
			<parent link="body_link"/>
			<child link="head_camera"/>
		</joint>

	</xacro:macro>
</robot>
