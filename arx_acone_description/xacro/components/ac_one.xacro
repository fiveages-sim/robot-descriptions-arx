<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:macro name="ac_one" params="name:='' direction:=1 collider:=convex">

		<link name="body_link">
			<inertial>
				<origin xyz="0.0040185 3.8157E-05 -0.024465"/>
				<mass value="5.6137" />
				<inertia
						ixx="0.21931087"
						ixy="0.00000492"
						ixz="-0.00198722"
						iyy="0.02598322"
						iyz="-0.00000228"
						izz="0.20840406" />
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find arx_acone_description)/meshes/ac_one/base.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find arx_acone_description)/meshes/ac_one/base.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<!-- ACone 底座横梁：不参与 OCS2 自碰对 -->
				<collision name="simple_base1">
					<origin xyz="0.002 0 -0.05" rpy="0 0 0"/>
					<geometry>
						<box size="0.14 0.6  0.1"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- 短相机立柱：独立 link，供 OCS2 只配臂↔立柱，避开底座 simple_base1 -->
		<link name="camera_pillar_link">
			<xacro:if value="${collider == 'simple'}">
				<collision name="simple_camera_pillar">
					<origin xyz="0.03 0 0.15" rpy="0 0 0"/>
					<geometry>
						<box size="0.04 0.06  0.3"/>
					</geometry>
				</collision>
				<collision name="simple_camera_pillar_top">
					<origin xyz="0.08 0 0.25" rpy="0 ${-PI/6} 0"/>
					<geometry>
						<box size="0.04 0.06  0.1"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>
		<joint name="camera_pillar_joint" type="fixed">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<parent link="body_link"/>
			<child link="camera_pillar_link"/>
		</joint>

		<link name="head_camera">
			<visual>
				<geometry>
					<mesh filename="file://$(find sensor_models)/meshes/realsense/d405.glb"/>
				</geometry>
			</visual>
		</link>

		<joint name="head_camera_joint" type="fixed">
			<origin xyz="0.090415 0.002 0.2285" rpy="-2.618 0 -1.5708"/>
			<parent link="body_link"/>
			<child link="head_camera"/>
		</joint>

	</xacro:macro>
</robot>
