; OCS2 Wheel Humanoid Configuration - ARX X7S
; ===========================================
; full_body → ocs2_wbc_controller（info_file_name:=task）。
; 本包仅保留本文件 + target_manager.yaml（无 fixed_base）。
;
; Body：lift_joint [m] + waist_joint pitch [rad]；头不进规划（removeJoints）。
;   State (3 + 16): [base x,y,yaw | lift | waist | left×7 | right×7]
;   Input (2 + 16): [vx, omega | lift_vel | waist_vel | left×7 | right×7]
; 底盘：manipulatorModelType=1。无 world→base TF 时 WBC 自动锁底盘并补发 identity TF（供 RViz marker）。

;=============================================================================
; Model Information
;=============================================================================

model_information
{
    ; 1 = WheelBasedMobileManipulator（虚拟 SE(2) 底盘）
    manipulatorModelType    1

    baseFrame               "base_link"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"
    bodyFrame               "body"

    removeJoints
    {
        [0]   "head_joint1"
        [1]   "head_joint2"
        [2]   "left_gripper_joint"
        [3]   "right_gripper_joint"
        [4]   "left_gripper_1"
        [5]   "right_gripper_1"
    }
}

;=============================================================================
; Model Settings
;=============================================================================

model_settings
{
    usePreComputation       true
    recompileLibraries      true
}

;=============================================================================
; Initial State — 3 + 16 = 19
;=============================================================================

initialState
{
    base
    {
        wheelBasedMobileManipulator
        {
            (0,0)  0.0   ; x [m]
            (1,0)  0.0   ; y [m]
            (2,0)  0.0   ; yaw [rad]
        }
    }

    arm
    {
        (0,0)   0.0     ; lift_joint [m]
        (1,0)   0.0     ; waist_joint [rad]

        (2,0)   0.0     ; left_joint1
        (3,0)   0.0     ; left_joint2
        (4,0)   0.0     ; left_joint3
        (5,0)   0.0     ; left_joint4
        (6,0)   0.0     ; left_joint5
        (7,0)   0.0     ; left_joint6
        (8,0)   0.0     ; left_joint7

        (9,0)   0.0     ; right_joint1
        (10,0)  0.0     ; right_joint2
        (11,0)  0.0     ; right_joint3
        (12,0)  0.0     ; right_joint4
        (13,0)  0.0     ; right_joint5
        (14,0)  0.0     ; right_joint6
        (15,0)  0.0     ; right_joint7
    }
}

;=============================================================================
; Initial Mode Schedule
;=============================================================================

initialModeSchedule
{
    eventTimes
    {
    }

    modeSequence
    {
        [0]     HM_DUAL_BODY_FREE
    }
}

;=============================================================================
; DDP Settings
;=============================================================================

ddp
{
    algorithm                       SLQ

    nThreads                        5
    threadPriority                  50

    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               false

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

;=============================================================================
; MPC Settings
;=============================================================================

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false

    debugPrint                      false

    mpcDesiredFrequency             100
    mrtDesiredFrequency             500
}

;=============================================================================
; Rollout Settings
;=============================================================================

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

;=============================================================================
; Body Tracking End Effector（BODY_TRACKING）
;=============================================================================

bodyTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

;=============================================================================
; Input Cost — 2 + 16 = 18
;=============================================================================

inputCost
{
    R
    {
        base
        {
            wheelBasedMobileManipulator
            {
                scaling 1e-1

                (0,0)   5.0
                (1,1)   5.0
            }
        }

        arm
        {
            ; 必须写对角 (i,i)：R 按 inputDim×inputDim 方阵加载，(i,0) 会留下近奇异 R → MPC 计划停更
            scaling 1e-3

            (0,0)   10.0    ; lift
            (1,1)   5.0     ; waist

            (2,2)   1.0     ; left 1-7
            (3,3)   1.0
            (4,4)   1.0
            (5,5)   1.0
            (6,6)   0.5
            (7,7)   0.5
            (8,8)   0.5

            (9,9)   1.0     ; right 1-7
            (10,10) 1.0
            (11,11) 1.0
            (12,12) 1.0
            (13,13) 0.5
            (14,14) 0.5
            (15,15) 0.5
        }
    }
}

;=============================================================================
; End Effector Constraint
;=============================================================================

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

bodyRelative
{
    activate                        false
}

bimanualCoupling
{
    activate                        true
    muPosition                      50.0
    muOrientation                   25.0
}

; 输入布局：[base(2) | lift | waist | left×7 | right×7]
waistLock
{
    activate                        true
    numJoints                       2
}

headCoupling
{
    activate                        false
}

customJointLock
{
    activate                        false
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-2

    lowerBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)  -0.3
                (1,0)  -0.3
            }
        }

        arm
        {
            (0,0)  -0.2
            (1,0)  -1.0

            (2,0)  -1.57
            (3,0)  -1.57
            (4,0)  -1.57
            (5,0)  -1.57
            (6,0)  -1.57
            (7,0)  -1.57
            (8,0)  -1.57

            (9,0)  -1.57
            (10,0) -1.57
            (11,0) -1.57
            (12,0) -1.57
            (13,0) -1.57
            (14,0) -1.57
            (15,0) -1.57
        }
    }

    upperBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)   0.3
                (1,0)   0.3
            }
        }

        arm
        {
            (0,0)  0.2
            (1,0)  1.0

            (2,0)  1.57
            (3,0)  1.57
            (4,0)  1.57
            (5,0)  1.57
            (6,0)  1.57
            (7,0)  1.57
            (8,0)  1.57

            (9,0)  1.57
            (10,0) 1.57
            (11,0) 1.57
            (12,0) 1.57
            (13,0) 1.57
            (14,0) 1.57
            (15,0) 1.57
        }
    }
}

selfCollision
{
    activate                        true

    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.02

    collisionObjectPairs
    {
    }

    collisionLinkPairs
    {
        [0] "left_upper_arm, lift",
        [1] "right_upper_arm, lift",
        [2] "left_forearm, body",
        [3] "right_forearm, body",
    }
}
