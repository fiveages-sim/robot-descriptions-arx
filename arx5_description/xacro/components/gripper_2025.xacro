<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find arx5_description)/xacro/components/camera.xacro"/>
    <xacro:macro name="arx_gripper_2025" params="prefix parent_link collider:=simple camera:=d405">
        <link name="${prefix}link6">
            <inertial>
                <origin xyz="0.040212 3.4542E-05 -0.010225"/>
                <mass value="0.34667"/>
                <inertia ixx="0.00047210" ixy="-0.00000041" ixz="-0.00002976" iyy="0.00049011" iyz="-0.00003393" izz="0.00018496"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find arx5_description)/meshes/ac1/link6.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find arx5_description)/meshes/ac1/link6.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}ee_to_link6_fixed" type="fixed">
            <parent link="${parent_link}"/>
            <child link="${prefix}link6"/>
        </joint>

        <link name="${prefix}link7">
            <inertial>
                <origin xyz="-0.0060354 -0.015602 0.013499"/>
                <mass value="0.08924"/>
                <inertia ixx="0.00009869" ixy="-0.00000394" ixz="0.00001011" iyy="0.00009021" iyz="0.00001113" izz="0.00006849"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find arx5_description)/meshes/ac1/link7.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find arx5_description)/meshes/ac1/link7.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}gripper_joint" type="prismatic">
            <origin xyz="0.08397 0.02721 -0.0062702"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link7"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="0.044" effort="100" velocity="5"/>
        </joint>

        <link name="${prefix}link8">
            <inertial>
                <origin xyz="-0.00581 0.015593 -0.012255"/>
                <mass value="0.089402"/>
                <inertia ixx="0.00007306" ixy="0.00000404" ixz="-0.00001526" iyy="0.00006428" iyz="0.00000327" izz="0.00006822"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find arx5_description)/meshes/ac1/link8.glb"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find arx5_description)/meshes/ac1/link8.glb"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="${prefix}joint8" type="prismatic">
            <origin xyz="0.08397 -0.023638 -0.0062703"/>
            <parent link="${prefix}link6"/>
            <child link="${prefix}link8"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0" upper="0.044" effort="100" velocity="5"/>
            <mimic joint="${prefix}gripper_joint" multiplier="1" offset="0"/>
        </joint>

        <link name="${prefix}gripper_center"/>
        <joint name="${prefix}gripper_center_fixed" type="fixed">
            <parent link="${prefix}link6"/>
            <child link="${prefix}gripper_center"/>
            <origin xyz="0.1424 0 0.0001057"/>
        </joint>

        <link name="${prefix}left_pad"/>
        <joint name="${prefix}left_pad_joint" type="fixed">
            <parent link="${prefix}link7"/>
            <child link="${prefix}left_pad"/>
            <origin xyz="0.05843 -0.0249 0.006376"/>
        </joint>

        <link name="${prefix}right_pad"/>
        <joint name="${prefix}right_pad_joint" type="fixed">
            <parent link="${prefix}link8"/>
            <child link="${prefix}right_pad"/>
            <origin xyz="0.05843 0.0249 0.006376"/>
        </joint>

        <xacro:arx_camera_component prefix="${prefix}" camera="${camera}" collider="${collider}"/>
        <xacro:if value="${camera == 'd405' or camera == 'd435' or camera == 'none'}">
            <joint name="${prefix}camera_support_fixed" type="fixed">
                <parent link="${prefix}link6"/>
                <child link="${prefix}camera_support"/>
                <origin xyz="0.0344 0 0.0208"/>
            </joint>
        </xacro:if>
    </xacro:macro>
</robot>
