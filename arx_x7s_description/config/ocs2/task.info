; OCS2 Wheel Humanoid Configuration - ARX X7S
; ===========================================
; full_body → ocs2_wbc_controller（info_file_name:=task）。
; split_body 臂 MPC：同包 task_arm.info + xacro_topology:=dual（见 ros2_controllers.yaml）。
;
; Body：lift_joint [m] + body_joint pitch [rad]；头进 WBC（MOVEJ /Head 可用）。
; Pinocchio 序（本包 xacro：Body 含头，再挂双臂）：
;   State (3 + 18): [base x,y,yaw | lift | body_joint | head×2 | left×7 | right×7]
;   Input (2 + 18): [vx, omega | lift_vel | body_vel | head×2 | left×7 | right×7]
; 底盘：manipulatorModelType=1。无 world→base TF 时 WBC 自动锁底盘并补发 identity TF（供 RViz marker）。

;=============================================================================
; Model Information
;=============================================================================

model_information
{
    ; 1 = WheelBasedMobileManipulator（虚拟 SE(2) 底盘）
    manipulatorModelType    1

    baseFrame               "base_link"
    eeFrame                 "left_eef"
    eeFrame1                "right_eef"
    bodyFrame               "body"

    removeJoints
    {
        [0]   "left_gripper_joint"
        [1]   "right_gripper_joint"
        [2]   "left_gripper_1"
        [3]   "right_gripper_1"
    }
}

;=============================================================================
; Model Settings
;=============================================================================

model_settings
{
    usePreComputation       true
    ; 模型 DOF 变更后须重编一次；稳定后可改回 false，避免每次进 OCS2 拖死
    recompileLibraries      true
}

;=============================================================================
; Initial State — 3 + 18 = 21
;=============================================================================

initialState
{
    base
    {
        wheelBasedMobileManipulator
        {
            (0,0)  0.0   ; x [m]
            (1,0)  0.0   ; y [m]
            (2,0)  0.0   ; yaw [rad]
        }
    }

    arm
    {
        (0,0)   0.0     ; lift_joint [m]
        (1,0)   0.0     ; body_joint [rad]
        (2,0)   0.0     ; head_joint1
        (3,0)   0.0     ; head_joint2

        (4,0)   0.0     ; left_joint1
        (5,0)   0.0     ; left_joint2
        (6,0)   0.0     ; left_joint3
        (7,0)   0.0     ; left_joint4
        (8,0)   0.0     ; left_joint5
        (9,0)   0.0     ; left_joint6
        (10,0)  0.0     ; left_joint7

        (11,0)  0.0     ; right_joint1
        (12,0)  0.0     ; right_joint2
        (13,0)  0.0     ; right_joint3
        (14,0)  0.0     ; right_joint4
        (15,0)  0.0     ; right_joint5
        (16,0)  0.0     ; right_joint6
        (17,0)  0.0     ; right_joint7
    }
}

;=============================================================================
; Initial Mode Schedule
;=============================================================================

initialModeSchedule
{
    eventTimes
    {
    }

    modeSequence
    {
        [0]     HM_DUAL_BODY_FREE
    }
}

;=============================================================================
; DDP Settings
;=============================================================================

ddp
{
    algorithm                       SLQ

    nThreads                        5
    threadPriority                  50

    maxNumIterations                1
    minRelCost                      0.1
    constraintTolerance             1e-3

    displayInfo                     false
    displayShortSummary             false
    checkNumericalStability         false
    debugPrintRollout               false
    debugCaching                    false

    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    maxNumStepsPerSecond            100000
    timeStep                        1e-3
    backwardPassIntegratorType      ODE45

    constraintPenaltyInitialValue   20.0
    constraintPenaltyIncreaseRate   2.0

    preComputeRiccatiTerms          true

    useFeedbackPolicy               false

    strategy                        LINE_SEARCH
    lineSearch
    {
        minStepLength                   1e-2
        maxStepLength                   1.0
        hessianCorrectionStrategy       DIAGONAL_SHIFT
        hessianCorrectionMultiple       1e-3
    }
}

;=============================================================================
; MPC Settings
;=============================================================================

mpc
{
    timeHorizon                     1.0
    solutionTimeWindow              0.2
    coldStart                       false

    debugPrint                      false

    mpcDesiredFrequency             100
    mrtDesiredFrequency             500
}

;=============================================================================
; Rollout Settings
;=============================================================================

rollout
{
    AbsTolODE                       1e-5
    RelTolODE                       1e-3
    timeStep                        1e-2
    integratorType                  ODE45
    maxNumStepsPerSecond            100000
    checkNumericalStability         false
}

;=============================================================================
; Body Tracking End Effector（BODY_TRACKING）
;=============================================================================

bodyTrackingEE
{
    activate  true
    muPosition 5.0
    muOrientation 5.0
}

;=============================================================================
; Input Cost — 2 + 18 = 20
;=============================================================================

inputCost
{
    R
    {
        base
        {
            wheelBasedMobileManipulator
            {
                scaling 1e-1

                (0,0)   5.0
                (1,1)   5.0
            }
        }

        arm
        {
            ; 必须写对角 (i,i)：R 按 inputDim×inputDim 方阵加载，(i,0) 会留下近奇异 R → MPC 计划停更
            scaling 1e-3

            (0,0)   10.0    ; lift
            (1,1)   5.0     ; body_joint
            (2,2)   1.0     ; head_joint1
            (3,3)   1.0     ; head_joint2

            (4,4)   1.0     ; left 1-7
            (5,5)   1.0
            (6,6)   1.0
            (7,7)   1.0
            (8,8)   0.5
            (9,9)   0.5
            (10,10) 0.5

            (11,11) 1.0     ; right 1-7
            (12,12) 1.0
            (13,13) 1.0
            (14,14) 1.0
            (15,15) 0.5
            (16,16) 0.5
            (17,17) 0.5
        }
    }
}

;=============================================================================
; End Effector Constraint
;=============================================================================

endEffector
{
    muPosition                      10.0
    muOrientation                   5.0
}

finalEndEffector
{
    muPosition                      20.0
    muOrientation                   10.0
}

bodyRelative
{
    activate                        false
}

bimanualCoupling
{
    activate                        true
    muPosition                      50.0
    muOrientation                   25.0
}

; 输入布局：[base(2) | lift | body_joint | head×2 | left×7 | right×7]
waistLock
{
    activate                        true
    numJoints                       2
}

headCoupling
{
    activate                        false
}

customJointLock
{
    activate                        false
}

armLock
{
    activate                        true
    leftNumJoints                   7
    rightNumJoints                  7
}

jointPositionLimits
{
    activate                        true
    mu                              1e-3
    delta                           1e-3
}

jointVelocityLimits
{
    mu                              1e-2
    delta                           1e-2

    lowerBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)  -0.3
                (1,0)  -0.3
            }
        }

        arm
        {
            (0,0)  -0.2
            (1,0)  -1.0
            (2,0)  -1.57    ; head1
            (3,0)  -1.57    ; head2

            (4,0)  -1.57
            (5,0)  -1.57
            (6,0)  -1.57
            (7,0)  -1.57
            (8,0)  -1.57
            (9,0)  -1.57
            (10,0) -1.57

            (11,0) -1.57
            (12,0) -1.57
            (13,0) -1.57
            (14,0) -1.57
            (15,0) -1.57
            (16,0) -1.57
            (17,0) -1.57
        }
    }

    upperBound
    {
        base
        {
            wheelBasedMobileManipulator
            {
                (0,0)   0.3
                (1,0)   0.3
            }
        }

        arm
        {
            (0,0)  0.2
            (1,0)  1.0
            (2,0)  1.57     ; head1
            (3,0)  1.57     ; head2

            (4,0)  1.57
            (5,0)  1.57
            (6,0)  1.57
            (7,0)  1.57
            (8,0)  1.57
            (9,0)  1.57
            (10,0) 1.57

            (11,0) 1.57
            (12,0) 1.57
            (13,0) 1.57
            (14,0) 1.57
            (15,0) 1.57
            (16,0) 1.57
            (17,0) 1.57
        }
    }
}

selfCollision
{
    ; 零位时 forearm–body / upper_arm–lift 易常开惩罚，MPC 跟不上 → plan 过期刷屏。
    ; 先关自碰；标定安全距离后再打开。
    activate                        false

    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.02

    collisionObjectPairs
    {
    }

    collisionLinkPairs
    {
        [0] "left_upper_arm, lift",
        [1] "right_upper_arm, lift",
        [2] "left_forearm, body",
        [3] "right_forearm, body",
    }
}
