<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- iface_mode: mix = pos/vel/effort（mock/gz）；position = 仅 position（Isaac） -->
	<xacro:macro name="lift_interfaces" params="iface_mode:=mix">

		<joint name="lift_joint">
			<command_interface name="position"/>
			<xacro:if value="${iface_mode == 'mix'}">
				<command_interface name="velocity"/>
				<command_interface name="effort"/>
			</xacro:if>
			<state_interface name="position">
				<param name="initial_value">0.3</param>
			</state_interface>
			<xacro:if value="${iface_mode == 'mix'}">
				<state_interface name="velocity"/>
				<state_interface name="effort"/>
			</xacro:if>
		</joint>

		<!-- 头：仅 position；当前不进 WBC / body 控制器 -->
		<joint name="head_joint1">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="head_joint2">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

	</xacro:macro>
</robot>
