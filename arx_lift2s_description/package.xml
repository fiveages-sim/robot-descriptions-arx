<?xml version="1.0"?>
<package format="2">
  <name>arx_lift2s_description</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for ARX Lift 2S</p>
    <p>Whole-body description composing the lift chassis with ARX AC One
      (arx_acone_description). Supports split-body and full-body control
      via ocs2_arm_controller launch files.
    </p>
  </description>
  <author>TODO</author>
  <maintainer email="TODO@email.com" />

  <license>BSD</license>

  <build_depend>arx5_description</build_depend>
  <build_depend>arx_acone_description</build_depend>
  <exec_depend>robot_common_launch</exec_depend>
  <exec_depend>arx5_description</exec_depend>
  <exec_depend>arx_acone_description</exec_depend>
  <exec_depend>component_models</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
