<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Component visualization for ARX LIFT2S                                         | -->
<!-- =================================================================================== -->
<robot name="ARX Lift2S" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:arg name="type" default="chassis"/>
	<xacro:arg name="collider" default="simple"/>

	<xacro:if value="${'$(arg type)' == 'chassis'}">
		<xacro:include filename="$(find arx_lift2s_description)/xacro/components/chassis.xacro"/>
		<xacro:chassis enable_wheel_joints="true"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'wheel'}">
		<xacro:include filename="$(find arx_lift2s_description)/xacro/components/wheel.xacro"/>
		<xacro:wheel wheel_name="wheel" enable_passive_wheels="true"/>

		<link name="base_link"/>
		<joint name="base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="wheel"/>
		</joint>
	</xacro:if>
</robot>
