        (10,10) 1.0
        (11,11) 0.5
        (12,12) 0.5
        (13,13) 0.5
    }
  }
}

endEffector
{
  dualArmMode      true
  leftArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
  rightArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
}

finalEndEffector
{
  dualArmMode      true
  leftArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
  rightArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
}

selfCollision
{
  activate  false
}

