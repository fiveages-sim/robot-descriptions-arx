<?xml version="1.0"?>
<package format="2">
  <name>arx_lift2s_description</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for ARX Lift 2S</p>
    <p>Config and xacro for dual X5 + lift via arxlift2s_ros2_control (official SDK).</p>
  </description>
  <author>FiveAges</author>
  <maintainer email="TODO@email.com">FiveAges</maintainer>

  <license>BSD</license>

  <exec_depend>arx5_description</exec_depend>
  <exec_depend>arxlift2s_ros2_control</exec_depend>
  <exec_depend>robot_common_launch</exec_depend>
  <exec_depend>ocs2_arm_controller</exec_depend>
  <exec_depend>basic_joint_controller</exec_depend>
  <exec_depend>adaptive_gripper_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
