<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arx_lift2s">
    <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
    <xacro:include filename="$(find arx_lift2s_description)/xacro/robot.xacro"/>
    <xacro:include filename="$(find arx5_description)/xacro/ros2_control/interfaces.xacro"/>
    <xacro:include filename="$(find arx_lift2s_description)/xacro/ros2_control/interfaces.xacro"/>

    <ros2_control name="arx_lift2s_unified_system" type="system">
        <hardware>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                <param name="joint_commands_topic">/isaac/joint_command</param>
                <param name="joint_states_topic">/isaac/joint_states</param>
            </xacro:if>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
                <plugin>arx_ros2_control/ArxX5Hardware</plugin>
                <param name="arm_config">DUAL</param>
                <param name="left_robot_model">X5</param>
                <param name="right_robot_model">X5</param>
                <param name="left_can_interface">can1</param>
                <param name="right_can_interface">can3</param>
                <!-- 双臂初始增益：可为左右臂设置不同的 kp/kd，不写则两臂使用相同默认值 -->
                <param name="left_joint_k_gains">[80.0, 70.0, 70.0, 30.0, 30.0, 20.0]</param>
                <param name="left_joint_d_gains">[2.0, 2.0, 2.0, 1.0, 1.0, 0.7]</param>
                <param name="right_joint_k_gains">[80.0, 70.0, 70.0, 30.0, 30.0, 20.0]</param>
                <param name="right_joint_d_gains">[2.0, 2.0, 2.0, 1.0, 1.0, 0.7]</param>
                <!-- 可选：左右夹爪增益，不写则用默认 -->
                <!-- <param name="left_gripper_kp">5.0</param> -->
                <!-- <param name="left_gripper_kd">0.2</param> -->
                <!-- <param name="right_gripper_kp">5.0</param> -->
                <!-- <param name="right_gripper_kd">0.2</param> -->
            </xacro:if>
        </hardware>

        <xacro:if value="${selected_base_type == 'lift2s'}">
            <xacro:arx_lift2s_base_interfaces/>
        </xacro:if>

        <xacro:arx5_interfaces name="left"/>
        <xacro:arx5_interfaces name="right"/>
    </ros2_control>

    <xacro:if value="$(arg gazebo)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find arx_lift2s_description)/config/ros2_control/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>