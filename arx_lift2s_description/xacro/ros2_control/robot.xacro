<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arx_lift2s">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>
	<!-- Lift2S real HI is full_control-only (OCS2 MIX). position/pd_control retired. -->
	<xacro:arg name="control_mode" default="full_control"/>
	<xacro:include filename="$(find arx_lift2s_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find arx5_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find arx_lift2s_description)/xacro/ros2_control/interfaces.xacro"/>

	<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
		<!-- Dual arms: Stanford arx5-sdk via arxlift2s ArxX5Hardware (can1 / can3) -->
		<ros2_control name="arx_lift2s_left_system" type="system">
			<hardware>
				<plugin>arxlift2s_ros2_control/ArxX5Hardware</plugin>
				<param name="robot_model">X5</param>
				<param name="can_interface">can1</param>
				<param name="control_mode">full_control</param>
				<!-- Screenshot / field-tuned Lift2S defaults -->
				<param name="joint_k_gains">[20.0, 20.0, 20.0, 20.0, 10.0, 10.0]</param>
				<param name="joint_d_gains">[3.5, 3.5, 3.5, 3.5, 1.0, 1.0]</param>
				<param name="gripper_kp">5.0</param>
				<param name="gripper_kd">0.2</param>
			</hardware>
			<xacro:arx5_interfaces name="left"/>
		</ros2_control>
		<ros2_control name="arx_lift2s_right_system" type="system">
			<hardware>
				<plugin>arxlift2s_ros2_control/ArxX5Hardware</plugin>
				<param name="robot_model">X5</param>
				<param name="can_interface">can3</param>
				<param name="control_mode">full_control</param>
				<param name="joint_k_gains">[20.0, 20.0, 20.0, 20.0, 10.0, 10.0]</param>
				<param name="joint_d_gains">[3.5, 3.5, 3.5, 3.5, 1.0, 1.0]</param>
				<param name="gripper_kp">5.0</param>
				<param name="gripper_kd">0.2</param>
			</hardware>
			<xacro:arx5_interfaces name="right"/>
		</ros2_control>
		<!-- Lift column: Hybrid MIT only (split + full body); Soft-P retired -->
		<ros2_control name="arx_lift2s_lift_system" type="system">
			<hardware>
				<plugin>arxlift2s_ros2_control/ArxLiftHardware</plugin>
				<param name="can_name">can5</param>
				<param name="robot_type">2</param>
				<!-- Hybrid MIT (sendLiftHybrid); live: arx_lift.hybrid_kp / hybrid_kd -->
				<param name="hybrid_kp">50.0</param>
				<param name="hybrid_kd">1.0</param>
				<param name="gravity_compensation_torque">-1.8</param>
				<param name="lift_max_torque">15.0</param>
				<param name="cmd_ramp_vel">0.12</param>
				<param name="max_height_m">0.48</param>
				<param name="height_span_m">0.48</param>
				<!-- SDK motor rad / meter -->
				<param name="height_rad_per_meter">41.54</param>
				<param name="sdk_max_rad">20.0</param>
			</hardware>
			<xacro:arx_lift2s_base_interfaces/>
		</ros2_control>
	</xacro:if>

	<xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real'}">
		<ros2_control name="arx_lift2s_system" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
				</xacro:if>
			</hardware>

			<xacro:arx_lift2s_base_interfaces/>
			<!-- Sim: MIX arm IFs to match real Stanford HI / full_control -->
			<xacro:arx5_interfaces name="left"/>
			<xacro:arx5_interfaces name="right"/>
		</ros2_control>
	</xacro:unless>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find arx_lift2s_description)/config/ros2_control/ros2_controllers.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>

</robot>
