<?xml version="1.0" ?>
<robot name="arx_lift" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- topology:
       full (default) = 底盘 + 升降 + 双臂 + 头（全身 / 真机 / 可视化）
       dual           = 仅双臂，根在 arm_base（分体 OCS2 规划，同 m6_ccs）
       全身 Pinocchio / WBC 关节序须为：lift | left×6 | right×6 | head×2 -->
  <xacro:arg name="topology" default="full"/>
  <xacro:arg name="type" default="x5"/>
  <xacro:arg name="enable_wheel_joints" default="false"/>

  <xacro:property name="topology_arg" value="$(arg topology)"/>
  <xacro:property name="type_arg" value="$(arg type)"/>
  <xacro:property name="selected_arm_type" value="x5"/>
  <xacro:if value="${type_arg == 'r5'}">
    <xacro:property name="selected_arm_type" value="r5"/>
  </xacro:if>

  <!-- ===== dual：仅双臂（分体规划，根 = arm_base，同 m6_ccs） ===== -->
  <xacro:if value="${topology_arg == 'dual'}">
    <link name="arm_base"/>
    <link name="body_link"/>
    <joint name="arm_base_body" type="fixed">
      <parent link="arm_base"/>
      <child link="body_link"/>
      <origin xyz="0 0 0"/>
    </joint>

    <xacro:if value="${selected_arm_type == 'x5'}">
      <xacro:include filename="$(find arx5_description)/xacro/X5.xacro"/>
      <xacro:X5 name="left"/>
      <xacro:X5 name="right"/>
    </xacro:if>
    <xacro:if value="${selected_arm_type == 'r5'}">
      <xacro:include filename="$(find arx5_description)/xacro/R5.xacro"/>
      <xacro:R5 name="left"/>
      <xacro:R5 name="right"/>
    </xacro:if>

    <joint name="arm_left_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="left_base_link"/>
      <origin xyz="0.208 0.25000 0.092"/>
    </joint>
    <joint name="arm_right_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="right_base_link"/>
      <origin xyz="0.208 -0.25000 0.092"/>
    </joint>
  </xacro:if>

  <!-- ===== full：整机（升降 → 双臂 → 头，匹配 WBC 布局） ===== -->
  <xacro:unless value="${topology_arg == 'dual'}">
    <xacro:include filename="$(find arx_lift_description)/xacro/components/mobile_base.xacro"/>
    <xacro:include filename="$(find arx_lift_description)/xacro/components/body.xacro"/>
    <xacro:include filename="$(find arx_lift_description)/xacro/components/head.xacro"/>

    <xacro:MobileBase enable_wheel_joints="$(arg enable_wheel_joints)"/>
    <xacro:Body/>

    <!-- 臂座：与 lift_link 固连 -->
    <link name="body_link"/>
    <joint name="body_fixed" type="fixed">
      <parent link="lift_link"/>
      <child link="body_link"/>
      <origin xyz="0 0 0"/>
    </joint>
    <link name="arm_base"/>
    <joint name="arm_base_joint" type="fixed">
      <parent link="lift_link"/>
      <child link="arm_base"/>
      <origin xyz="0 0 0"/>
    </joint>

    <xacro:if value="${selected_arm_type == 'x5'}">
      <xacro:include filename="$(find arx5_description)/xacro/X5.xacro"/>
      <xacro:X5 name="left"/>
      <xacro:X5 name="right"/>
    </xacro:if>
    <xacro:if value="${selected_arm_type == 'r5'}">
      <xacro:include filename="$(find arx5_description)/xacro/R5.xacro"/>
      <xacro:R5 name="left"/>
      <xacro:R5 name="right"/>
    </xacro:if>

    <joint name="arm_left_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="left_base_link"/>
      <origin xyz="0.208 0.25000 0.092"/>
    </joint>
    <joint name="arm_right_fixed" type="fixed">
      <parent link="arm_base"/>
      <child link="right_base_link"/>
      <origin xyz="0.208 -0.25000 0.092"/>
    </joint>

    <!-- 头放在双臂之后，Pinocchio 序 = lift | L6 | R6 | head×2 -->
    <xacro:Head/>
  </xacro:unless>
</robot>
