; OCS2 Dual-Arm Configuration - ARX X7S arms (split_body planning)
; ================================================================
; Used by arx_x7s ocs2_arm_controller via robot_name:=arx_x7s_arms.
; Planning URDF: this package xacro/robot.xacro (root=body, L7+R7 only).
; Hardware / full-body WBC stay on arx_x7s_description + task.info.

; robot model meta-information
model_information {
  manipulatorModelType     0      // 0: Default-arm

  removeJoints {
      [0]  "left_gripper_joint"
      [1]  "right_gripper_joint"
      [2]  "left_gripper_1"
      [3]  "right_gripper_1"
  }

  baseFrame                       "body"
  eeFrame                         "left_eef"
  eeFrame1                        "right_eef"
}

model_settings
{
  usePreComputation               true
  recompileLibraries              true
}

ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      0.1
  constraintTolerance             1e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false
  debugCaching                    false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            100000
  timeStep                        1e-3
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-3
  }
}

rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        1e-2
  integratorType                  ODE45
  maxNumStepsPerSecond            100000
  checkNumericalStability         false
}

mpc
{
  timeHorizon                     1.0
  solutionTimeWindow              0.2
  coldStart                       false

  debugPrint                      false

  mpcDesiredFrequency             100
  mrtDesiredFrequency             400
}

; state = 14（left×7 | right×7）
initialState
{
  arm
  {
    (0,0)   0.0     ; left_joint1
    (1,0)   0.0     ; left_joint2
    (2,0)   0.0     ; left_joint3
    (3,0)   0.0     ; left_joint4
    (4,0)   0.0     ; left_joint5
    (5,0)   0.0     ; left_joint6
    (6,0)   0.0     ; left_joint7

    (7,0)   0.0     ; right_joint1
    (8,0)   0.0     ; right_joint2
    (9,0)   0.0     ; right_joint3
    (10,0)  0.0     ; right_joint4
    (11,0)  0.0     ; right_joint5
    (12,0)  0.0     ; right_joint6
    (13,0)  0.0     ; right_joint7
  }
}

inputCost
{
  R
  {
    base
    {
      defaultManipulator
      {
      }

      floatingArmManipulator
      {
      }

      fullyActuatedFloatingArmManipulator
      {
        scaling 1e-2
        (0,0)  5.0
        (1,1)  5.0
        (2,2)  5.0
        (3,3)  5.0
        (4,4)  5.0
        (5,5)  5.0
      }

      wheelBasedMobileManipulator
      {
        scaling 1e-2
        (0,0)  1.5
        (1,1)  1.5
      }
    }

    ; 对角 (i,i)：R 按方阵加载
    arm
