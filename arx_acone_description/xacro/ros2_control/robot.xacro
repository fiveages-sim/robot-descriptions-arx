<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arx_acone">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>
	<!-- Arms: full_control only (MIT MIX). Left can1 / right can3. -->

	<xacro:include filename="$(find arx_acone_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find arx5_description)/xacro/ros2_control/interfaces.xacro"/>

	<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
		<!-- Dual-arm real: Stanford arx5-sdk via arx_ros2_control. -->
		<ros2_control name="arx_acone_left_system" type="system">
			<hardware>
				<plugin>arx_ros2_control/ArxX5Hardware</plugin>
				<param name="robot_model">X5</param>
				<param name="can_interface">can1</param>
				<param name="control_mode">full_control</param>
				<!-- Align with Lift2S field-tuned MIX defaults -->
				<param name="joint_k_gains">[20.0, 20.0, 20.0, 20.0, 10.0, 10.0]</param>
				<param name="joint_d_gains">[0.8, 0.8, 0.8, 0.8, 0.5, 0.5]</param>
			</hardware>
			<xacro:arx5_interfaces name="left"/>
		</ros2_control>
		<ros2_control name="arx_acone_right_system" type="system">
			<hardware>
				<plugin>arx_ros2_control/ArxX5Hardware</plugin>
				<param name="robot_model">X5</param>
				<param name="can_interface">can3</param>
				<param name="control_mode">full_control</param>
				<param name="joint_k_gains">[20.0, 20.0, 20.0, 20.0, 10.0, 10.0]</param>
				<param name="joint_d_gains">[0.8, 0.8, 0.8, 0.8, 0.5, 0.5]</param>
			</hardware>
			<xacro:arx5_interfaces name="right"/>
		</ros2_control>
	</xacro:if>

	<xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real'}">
		<ros2_control name="arx_acone_system" type="system">
			<hardware>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
					<plugin>gz_ros2_control/GazeboSimSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
					<plugin>mock_components/GenericSystem</plugin>
				</xacro:if>
				<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
					<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
					<param name="joint_commands_topic">/isaac/joint_command</param>
					<param name="joint_states_topic">/isaac/joint_states</param>
				</xacro:if>
			</hardware>
			<xacro:arx5_interfaces name="left"/>
			<xacro:arx5_interfaces name="right"/>
		</ros2_control>
	</xacro:unless>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find arx_acone_description)/config/ros2_control/ros2_controllers.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>

</robot>
